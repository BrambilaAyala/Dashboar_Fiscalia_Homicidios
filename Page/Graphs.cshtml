@page
@model ProyectoFisca.Pages.GraphsModel
@{
    ViewData["Title"] = "Analítica y Series de Tiempo";
}

<div class="mb-4">
    <!-- Encabezado Limpio -->
    <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-3 border-bottom">
        <div>
            <h2 class="h4 fw-bold text-slate-900 mb-1">Analítica y Tendencias Temporales</h2>
            <p class="text-secondary small mb-0">Comportamiento histórico trimestral, comparativas de género y focos estatales de violencia.</p>
        </div>
        <!-- Filtro Interactivo de Años Requerido -->
        <div class="d-flex align-items-center gap-2 mt-2 mt-sm-0">
            <span class="small text-secondary fw-medium">Filtrar Año:</span>
            <div class="btn-group btn-group-sm" role="group" aria-label="Filtro de Años">
                <button type="button" class="btn btn-primary active btn-filtro-anio" onclick="filtrarPorAnio('todos', this)">Todos</button>
                <button type="button" class="btn btn-outline-secondary btn-filtro-anio" onclick="filtrarPorAnio('2023', this)">2023</button>
                <button type="button" class="btn btn-outline-secondary btn-filtro-anio" onclick="filtrarPorAnio('2024', this)">2024</button>
                <button type="button" class="btn btn-outline-secondary btn-filtro-anio" onclick="filtrarPorAnio('2025', this)">2025</button>
                <button type="button" class="btn btn-outline-secondary btn-filtro-anio" onclick="filtrarPorAnio('2026', this)">2026</button>
            </div>
        </div>
    </div>

    <!-- Indicadores Dinámicos -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card border-top border-3 border-danger">
                <div class="stat-label">Víctimas en Período</div>
                <div id="kpiTotalMuertos" class="stat-value text-danger">@Model.GranTotalMuertos.ToString("N0")</div>
                <div id="kpiTrimestresInfo" class="stat-help">@Model.Trimestres.Count trimestres registrados</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card border-top border-3 border-primary">
                <div class="stat-label">Hombres</div>
                <div id="kpiTotalHombres" class="stat-value text-primary">@Model.GranTotalHombres.ToString("N0")</div>
                <div id="kpiPctHombres" class="stat-help">Proporción: @Model.PorcentajeHombres%</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card border-top border-3 border-warning">
                <div class="stat-label">Mujeres</div>
                <div id="kpiTotalMujeres" class="stat-value text-warning">@Model.GranTotalMujeres.ToString("N0")</div>
                <div id="kpiPctMujeres" class="stat-help">Proporción: @Model.PorcentajeMujeres%</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card border-top border-3 border-secondary">
                <div class="stat-label">No Identificados</div>
                <div id="kpiTotalNoIdentificado" class="stat-value text-secondary">@Model.GranTotalNoIdentificado.ToString("N0")</div>
                <div id="kpiPctNoIdentificado" class="stat-help">Proporción: @Model.PorcentajeNoIdentificado%</div>
            </div>
        </div>
    </div>

    <!-- Fila Principal de Gráficas Interactivas -->
    <div class="row g-4 mb-4">
        <!-- Gráfica de Serie Temporal con Controles Dinámicos -->
        <div class="col-lg-8">
            <div class="card card-clean overflow-hidden h-100">
                <div class="card-header py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2" style="background-color: #f1f5f9; border-color: #cbd5e1 !important;">
                    <div>
                        <h6 class="fw-bold mb-0 text-slate-800">Evolución Trimestral e Histórica</h6>
                        <span id="subtituloSerie" class="small text-muted">Mostrando serie multianual completa</span>
                    </div>
                    <!-- Controles Interactivos de Gráfica -->
                    <div class="d-flex align-items-center gap-2">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" id="btnTipoBarra" class="btn btn-outline-primary active btn-sm" onclick="cambiarTipoGrafica('bar')">
                                Barras
                            </button>
                            <button type="button" id="btnTipoLinea" class="btn btn-outline-primary btn-sm" onclick="cambiarTipoGrafica('line')">
                                Líneas
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-3">
                    <div style="position: relative; height: 320px; width: 100%;">
                        <canvas id="chartTrimestres"></canvas>
                    </div>
                </div>
                <div class="card-footer py-2 px-3 border-top small text-secondary d-flex justify-content-between align-items-center" style="background-color: #f1f5f9; border-color: #cbd5e1 !important;">
                    <span>Haga clic en los elementos de la leyenda para ocultar/mostrar capas específicas.</span>
                    <span id="badgeFiltroActivo" class="badge badge-soft-primary">Todos los Años</span>
                </div>
            </div>
        </div>

        <!-- Gráfica de Distribución de Género -->
        <div class="col-lg-4">
            <div class="card card-clean overflow-hidden h-100">
                <div class="card-header py-3 border-bottom" style="background-color: #f1f5f9; border-color: #cbd5e1 !important;">
                    <h6 class="fw-bold mb-0 text-slate-800">Distribución por Género</h6>
                </div>
                <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center">
                    <div style="position: relative; height: 230px; width: 230px;">
                        <canvas id="chartGenero"></canvas>
                    </div>
                    <div class="d-flex justify-content-around w-100 mt-3 pt-3 border-top text-center">
                        <div>
                            <span class="badge badge-soft-primary">Hombres</span>
                            <div id="lblPctHombres" class="fw-bold small mt-1 text-primary">@Model.PorcentajeHombres%</div>
                        </div>
                        <div>
                            <span class="badge badge-soft-warning">Mujeres</span>
                            <div id="lblPctMujeres" class="fw-bold small mt-1 text-warning">@Model.PorcentajeMujeres%</div>
                        </div>
                        <div>
                            <span class="badge badge-soft-secondary">N/I</span>
                            <div id="lblPctNoIdentificado" class="fw-bold small mt-1 text-secondary">@Model.PorcentajeNoIdentificado%</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla Detallada & Top Entidades -->
    <div class="row g-4">
        <!-- Tabla Trimestral Dinámica -->
        <div class="col-lg-7">
            <div class="card card-clean overflow-hidden">
                <div class="card-header py-3 border-bottom d-flex justify-content-between align-items-center" style="background-color: #f1f5f9; border-color: #cbd5e1 !important;">
                    <h6 class="fw-bold mb-0 text-slate-800">Desglose Trimestral y Estacional</h6>
                    <span id="tablaConteo" class="badge badge-soft-secondary">@Model.Trimestres.Count registros</span>
                </div>
                <div class="table-responsive" style="max-height: 340px; overflow-y: auto;">
                    <table class="table table-clean table-sm table-hover mb-0">
                        <thead class="sticky-top bg-light">
                            <tr>
                                <th>Trimestre</th>
                                <th class="text-center">Víctimas</th>
                                <th class="text-center">Hombres</th>
                                <th class="text-center">Mujeres</th>
                                <th class="text-center">N/I</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyTrimestres">
                            @foreach (var t in Model.Trimestres)
                            {
                                <tr data-trimestre="@t.Trimestre">
                                    <td class="fw-medium text-dark">@t.Trimestre</td>
                                    <td class="text-center">
                                        <span class="badge badge-soft-danger fw-bold">@t.Num_Muertos</span>
                                    </td>
                                    <td class="text-center small text-primary">@t.Hombres</td>
                                    <td class="text-center small text-warning">@t.Mujeres</td>
                                    <td class="text-center small text-secondary">@t.No_Identificado</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Gráfica Top Entidades Federativas -->
        <div class="col-lg-5">
            <div class="card card-clean overflow-hidden h-100">
                <div class="card-header py-3 border-bottom d-flex justify-content-between align-items-center" style="background-color: #f1f5f9; border-color: #cbd5e1 !important;">
                    <h6 class="fw-bold mb-0 text-slate-800">Top 10 Entidades con Mayor Incidencia</h6>
                    <span class="badge badge-soft-danger">Focos Críticos</span>
                </div>
                <div class="card-body p-3">
                    <div style="position: relative; height: 320px; width: 100%;">
                        <canvas id="chartEntidades"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const todosTrimestres = @Html.Raw(Model.TrimestresJson);
    const todasEntidades = @Html.Raw(Model.EntidadesJson);

    let anioSeleccionado = 'todos';
    let tipoGraficaActual = 'bar';
    let chartTrimestresInstancia = null;
    let chartGeneroInstancia = null;
    let chartEntidadesInstancia = null;

    function obtenerDatosFiltrados() {
        if (anioSeleccionado === 'todos') {
            return todosTrimestres;
        }
        return todosTrimestres.filter(t => t.Trimestre.includes(anioSeleccionado));
    }

    function inicializarChartTrimestres() {
        const datos = obtenerDatosFiltrados();
        const labels = datos.map(d => d.Trimestre);
        const muertos = datos.map(d => d.Num_Muertos);
        const hombres = datos.map(d => d.Hombres);
        const mujeres = datos.map(d => d.Mujeres);
        const ctx = document.getElementById('chartTrimestres').getContext('2d');

        if (chartTrimestresInstancia) {
            chartTrimestresInstancia.destroy();
        }

        const isBar = tipoGraficaActual === 'bar';

        chartTrimestresInstancia = new Chart(ctx, {
            type: tipoGraficaActual,
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Total Víctimas',
                        data: muertos,
                        type: tipoGraficaActual,
                        backgroundColor: isBar ? 'rgba(220, 38, 38, 0.75)' : 'transparent',
                        borderColor: '#dc2626',
                        borderWidth: isBar ? 1 : 2.5,
                        borderRadius: isBar ? 4 : 0,
                        tension: 0.3,
                        pointRadius: isBar ? 0 : 4,
                        pointBackgroundColor: '#dc2626'
                    },
                    {
                        label: 'Hombres',
                        data: hombres,
                        type: tipoGraficaActual,
                        backgroundColor: isBar ? 'rgba(37, 99, 235, 0.75)' : 'transparent',
                        borderColor: '#2563eb',
                        borderWidth: isBar ? 1 : 2,
                        borderRadius: isBar ? 4 : 0,
                        tension: 0.3,
                        pointRadius: isBar ? 0 : 3,
                        pointBackgroundColor: '#2563eb'
                    },
                    {
                        label: 'Mujeres',
                        data: mujeres,
                        type: tipoGraficaActual,
                        backgroundColor: isBar ? 'rgba(217, 119, 6, 0.75)' : 'transparent',
                        borderColor: '#d97706',
                        borderWidth: isBar ? 1 : 2,
                        borderRadius: isBar ? 4 : 0,
                        tension: 0.3,
                        pointRadius: isBar ? 0 : 3,
                        pointBackgroundColor: '#d97706'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            font: { family: 'Inter', size: 12 },
                            usePointStyle: true,
                            boxWidth: 8
                        }
                    },
                    tooltip: {
                        padding: 10,
                        titleFont: { family: 'Inter', weight: 'bold' },
                        bodyFont: { family: 'Inter' }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#f1f5f9' },
                        ticks: { font: { family: 'Inter', size: 11 } }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { font: { family: 'Inter', size: 11 } }
                    }
                }
            }
        });
    }

    function inicializarChartGenero() {
        const datos = obtenerDatosFiltrados();
        const totalH = datos.reduce((acc, d) => acc + d.Hombres, 0);
        const totalM = datos.reduce((acc, d) => acc + d.Mujeres, 0);
        const totalNI = datos.reduce((acc, d) => acc + d.No_Identificado, 0);
        const ctx = document.getElementById('chartGenero').getContext('2d');

        if (chartGeneroInstancia) {
            chartGeneroInstancia.destroy();
        }

        chartGeneroInstancia = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Hombres', 'Mujeres', 'No Identificado'],
                datasets: [{
                    data: [totalH, totalM, totalNI],
                    backgroundColor: ['#2563eb', '#d97706', '#94a3b8'],
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                cutout: '70%'
            }
        });

        const totalG = totalH + totalM + totalNI;
        const pctH = totalG > 0 ? (totalH / totalG * 100).toFixed(1) : '0';
        const pctM = totalG > 0 ? (totalM / totalG * 100).toFixed(1) : '0';
        const pctNI = totalG > 0 ? (totalNI / totalG * 100).toFixed(1) : '0';

        document.getElementById('lblPctHombres').innerText = pctH + '%';
        document.getElementById('lblPctMujeres').innerText = pctM + '%';
        document.getElementById('lblPctNoIdentificado').innerText = pctNI + '%';

        // Actualizar KPIs superiores
        const totalMuertos = datos.reduce((acc, d) => acc + d.Num_Muertos, 0);
        document.getElementById('kpiTotalMuertos').innerText = totalMuertos.toLocaleString();
        document.getElementById('kpiTotalHombres').innerText = totalH.toLocaleString();
        document.getElementById('kpiTotalMujeres').innerText = totalM.toLocaleString();
        document.getElementById('kpiTotalNoIdentificado').innerText = totalNI.toLocaleString();
        document.getElementById('kpiPctHombres').innerText = 'Proporción: ' + pctH + '%';
        document.getElementById('kpiPctMujeres').innerText = 'Proporción: ' + pctM + '%';
        document.getElementById('kpiPctNoIdentificado').innerText = 'Proporción: ' + pctNI + '%';
        document.getElementById('kpiTrimestresInfo').innerText = datos.length + ' trimestres en filtro';
    }

    function inicializarChartEntidades() {
        const ctx = document.getElementById('chartEntidades').getContext('2d');
        if (chartEntidadesInstancia) {
            chartEntidadesInstancia.destroy();
        }

        chartEntidadesInstancia = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: todasEntidades.map(e => e.Entidad),
                datasets: [{
                    label: 'Víctimas',
                    data: todasEntidades.map(e => e.Num_Muertos),
                    backgroundColor: 'rgba(220, 38, 38, 0.75)',
                    borderColor: '#dc2626',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        grid: { color: '#f1f5f9' },
                        ticks: { font: { family: 'Inter', size: 10 } }
                    },
                    y: {
                        grid: { display: false },
                        ticks: { font: { family: 'Inter', size: 10 } }
                    }
                }
            }
        });
    }

    function filtrarTablaTrimestres() {
        const rows = document.querySelectorAll('#tbodyTrimestres tr');
        let contador = 0;
        rows.forEach(r => {
            const trText = r.getAttribute('data-trimestre') || '';
            if (anioSeleccionado === 'todos' || trText.includes(anioSeleccionado)) {
                r.style.display = '';
                contador++;
            } else {
                r.style.display = 'none';
            }
        });
        document.getElementById('tablaConteo').innerText = contador + ' registros';
    }

    function filtrarPorAnio(anio, btnElement) {
        anioSeleccionado = anio;

        // Actualizar botones
        document.querySelectorAll('.btn-filtro-anio').forEach(b => {
            b.className = 'btn btn-outline-secondary btn-filtro-anio';
        });
        if (btnElement) {
            btnElement.className = 'btn btn-primary active btn-filtro-anio';
        }

        const badge = document.getElementById('badgeFiltroActivo');
        const subtitulo = document.getElementById('subtituloSerie');
        if (anio === 'todos') {
            badge.innerText = 'Todos los Años';
            subtitulo.innerText = 'Mostrando serie multianual completa';
        } else {
            badge.innerText = 'Año ' + anio;
            subtitulo.innerText = 'Mostrando serie estacional de ' + anio;
        }

        inicializarChartTrimestres();
        inicializarChartGenero();
        filtrarTablaTrimestres();
    }

    function cambiarTipoGrafica(tipo) {
        tipoGraficaActual = tipo;
        document.getElementById('btnTipoBarra').className = tipo === 'bar' ? 'btn btn-primary active btn-sm' : 'btn btn-outline-primary btn-sm';
        document.getElementById('btnTipoLinea').className = tipo === 'line' ? 'btn btn-primary active btn-sm' : 'btn btn-outline-primary btn-sm';
        inicializarChartTrimestres();
    }

    // Inicializar gráficos
    inicializarChartTrimestres();
    inicializarChartGenero();
    inicializarChartEntidades();
</script>
}
