@page
@model ProyectoFisca.Pages.AuditoriaModel
@{
    ViewData["Title"] = "Auditoría y Calidad Forense";
}

<div class="mb-4">
    <!-- Encabezado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-3 border-bottom" style="border-color: #cbd5e1 !important;">
        <div>
            <h2 class="h4 fw-bold text-slate-900 mb-1">Auditoría Forense y Calidad de Datos</h2>
            <p class="text-secondary small mb-0">Supervisión técnica de boletines omitidos, anomalías ortográficas en entidades, municipios no reconocidos e integridad de la ingesta (2023–2026).</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-sm-0">
            <button id="btnExportAuditoriaCsv" class="btn btn-outline-secondary btn-sm px-3 fw-medium">
                📊 Exportar Reporte de Calidad CSV
            </button>
            <a href="/Fisca" class="btn btn-primary btn-sm px-3 fw-medium">
                📥 Ir a Ingesta Oficial
            </a>
        </div>
    </div>

    <!-- Tarjetas de Métricas de Calidad Forense (KPIs) -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card border-top border-3 border-primary">
                <div class="stat-label">Archivos en Repositorio</div>
                <div class="stat-value text-primary">@Model.Resumen.TotalArchivosAnalizados</div>
                <div class="stat-help">Boletines diarios (2023 - 2026)</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card border-top border-3 border-success">
                <div class="stat-label">Archivos con Texto Digital</div>
                <div class="stat-value text-success">@Model.Resumen.TotalArchivosValidosTexto</div>
                <div class="d-flex align-items-center">
                    <div class="progress flex-grow-1 me-2" style="height: 5px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @Model.Resumen.PorcentajeArchivosValidos%"></div>
                    </div>
                    <span class="small fw-semibold text-success">@Model.Resumen.PorcentajeArchivosValidos%</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card border-top border-3 border-danger">
                <div class="stat-label">Omitidos por Imagen Escaneada</div>
                <div class="stat-value text-danger">@Model.Resumen.TotalArchivosOmitidosImagen</div>
                <div class="stat-help">Sin capa de texto vectorial (ej. Sep 2024)</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card border-top border-3 border-warning">
                <div class="stat-label">Datos con Anomalías / Corregidos</div>
                <div class="stat-value text-warning">@Model.Resumen.TotalInconsistenciasDetectadas</div>
                <div class="stat-help">Índice de precisión: @Model.Resumen.IndiceCalidadDatos%</div>
            </div>
        </div>
    </div>

    <!-- Fila 1 de Gráficas: Archivos Omitidos vs Motivos -->
    <div class="row g-4 mb-4">
        <!-- Gráfica 1: Clasificación de Archivos Oficiales -->
        <div class="col-lg-5">
            <div class="card card-clean h-100 overflow-hidden">
                <div class="card-header py-3 d-flex justify-content-between align-items-center border-bottom" style="background-color: #f1f5f9; border-color: #cbd5e1 !important;">
                    <h6 class="fw-bold mb-0 text-slate-800">Estado de Archivos y Boletines</h6>
                    <span class="badge badge-soft-primary">Auditoría de Ingesta</span>
                </div>
                <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center">
                    <div style="position: relative; height: 230px; width: 230px;">
                        <canvas id="chartEstadoArchivos"></canvas>
                    </div>
                    <div class="d-flex justify-content-around w-100 mt-3 pt-3 border-top text-center" style="border-color: #e2e8f0 !important;">
                        <div>
                            <span class="badge badge-soft-primary">Con Texto</span>
                            <div class="fw-bold small mt-1 text-primary">@Model.Resumen.TotalArchivosValidosTexto</div>
                        </div>
                        <div>
                            <span class="badge badge-soft-danger">Imagen Scan</span>
                            <div class="fw-bold small mt-1 text-danger">@Model.Resumen.TotalArchivosOmitidosImagen</div>
                        </div>
                        <div>
                            <span class="badge badge-soft-warning">No Publicado</span>
                            <div class="fw-bold small mt-1 text-warning">@Model.Resumen.TotalArchivosNoDisponibles</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráfica 2: Desglose de Motivos de Inconsistencia -->
        <div class="col-lg-7">
            <div class="card card-clean h-100 overflow-hidden">
                <div class="card-header py-3 d-flex justify-content-between align-items-center border-bottom" style="background-color: #f1f5f9; border-color: #cbd5e1 !important;">
                    <h6 class="fw-bold mb-0 text-slate-800">Causas de Datos Omitidos o que Requirieron Corrección</h6>
                    <span class="badge badge-soft-secondary">Clasificación</span>
                </div>
                <div class="card-body p-3">
                    <div style="position: relative; height: 260px; width: 100%;">
                        <canvas id="chartMotivosInconsistencia"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 2 de Gráficas: Entidades con Errores de Captura & Serie Temporal -->
    <div class="row g-4 mb-4">
        <!-- Gráfica 3: Entidades Federativas con Mayor Número de Imprecisiones -->
        <div class="col-lg-6">
            <div class="card card-clean h-100 overflow-hidden">
                <div class="card-header py-3 d-flex justify-content-between align-items-center border-bottom" style="background-color: #f1f5f9; border-color: #cbd5e1 !important;">
                    <h6 class="fw-bold mb-0 text-slate-800">Entidades con Mayor Incidencia de Nombres Imprecisos / Alias</h6>
                    <span class="badge badge-soft-danger">Focos de Imprecisión</span>
                </div>
                <div class="card-body p-3">
                    <div style="position: relative; height: 250px; width: 100%;">
                        <canvas id="chartEntidadesInconsistencias"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráfica 4: Incidencias por Año -->
        <div class="col-lg-6">
            <div class="card card-clean h-100 overflow-hidden">
                <div class="card-header py-3 d-flex justify-content-between align-items-center border-bottom" style="background-color: #f1f5f9; border-color: #cbd5e1 !important;">
                    <h6 class="fw-bold mb-0 text-slate-800">Distribución de Anomalías por Año (2023 - 2026)</h6>
                    <span class="badge badge-soft-primary">Evolución Anual</span>
                </div>
                <div class="card-body p-3">
                    <div style="position: relative; height: 250px; width: 100%;">
                        <canvas id="chartAniosInconsistencias"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Barra de Filtros de la Tabla de Auditoría con Auto-Filtrado Reactivo -->
    <div class="card card-clean p-3 mb-4">
        <form id="formFiltrosAuditoria" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" id="inputBuscarAuditoria" class="form-control form-control-sm" name="Buscar" value="@Model.Buscar" placeholder="🔍 Buscar por entidad, municipio, motivo o fecha..." autocomplete="off" />
            </div>
            <div class="col-md-4">
                <select class="form-select form-select-sm" name="FiltroMotivo" onchange="this.form.submit()">
                    <option value="TODOS" selected="@(Model.FiltroMotivo == "TODOS")">📑 Todos los Motivos de Inconsistencia</option>
                    <option value="Imagen" selected="@(Model.FiltroMotivo == "Imagen")">🖼️ Boletines en Imagen Escaneada</option>
                    <option value="Entidad" selected="@(Model.FiltroMotivo == "Entidad")">🏛️ Entidades No Reconocidas / Abreviadas</option>
                    <option value="Municipio" selected="@(Model.FiltroMotivo == "Municipio")">📍 Municipios No Reconocidos / Ambiguos</option>
                    <option value="Fuente" selected="@(Model.FiltroMotivo == "Fuente")">📰 Sin Fuente Periodística Verificable</option>
                    <option value="Discrepancia" selected="@(Model.FiltroMotivo == "Discrepancia")">⚖️ Discrepancia en Conteo de Género</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-medium">Filtrar</button>
                <a href="/Auditoria" class="btn btn-outline-secondary btn-sm fw-medium">Limpiar</a>
            </div>
        </form>
    </div>

    <!-- Tabla Detallada de Auditoría Forense -->
    <div class="card card-clean overflow-hidden mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center border-bottom" style="background-color: #f1f5f9; border-color: #cbd5e1 !important;">
            <h6 class="fw-bold mb-0 text-slate-800">Bitácora Forense de Inconsistencias y Datos Auditados</h6>
            <span class="badge badge-soft-secondary">Página @Model.Pagina de @(Model.TotalPaginas > 0 ? Model.TotalPaginas : 1) (@Model.TotalRegistrosFiltrados registros)</span>
        </div>
        <div class="table-responsive">
            <table id="tablaAuditoria" class="table table-clean table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Fecha Boletín</th>
                        <th>Entidad en PDF</th>
                        <th>Municipio en PDF</th>
                        <th class="text-center">Víctimas</th>
                        <th>Diagnóstico / Motivo de Inconsistencia</th>
                        <th>Fuente</th>
                        <th class="text-center">Estado Forense</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RegistrosPaginados.Any())
                    {
                        @foreach (var r in Model.RegistrosPaginados)
                        {
                            <tr>
                                <td class="text-muted small">@r.Id</td>
                                <td class="text-nowrap small text-secondary">@r.Fecha.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="badge @(r.EntidadDetectada?.Contains("NACIONAL") == true ? "badge-soft-danger" : "badge-soft-secondary")">
                                        @r.EntidadDetectada
                                    </span>
                                </td>
                                <td class="fw-medium text-dark">@r.MunicipioDetectado</td>
                                <td class="text-center">
                                    <span class="badge @(r.NumMuertos > 0 ? "badge-soft-danger" : "badge-soft-secondary") fw-bold">
                                        @r.NumMuertos
                                    </span>
                                </td>
                                <td class="small">
                                    @if (r.MotivoInconsistencia?.Contains("imagen", StringComparison.OrdinalIgnoreCase) == true)
                                    {
                                        <span class="text-danger fw-medium">🖼️ @r.MotivoInconsistencia</span>
                                    }
                                    else if (r.MotivoInconsistencia?.Contains("abreviatura", StringComparison.OrdinalIgnoreCase) == true || r.MotivoInconsistencia?.Contains("alias", StringComparison.OrdinalIgnoreCase) == true)
                                    {
                                        <span class="text-primary fw-medium">✍️ @r.MotivoInconsistencia</span>
                                    }
                                    else if (r.MotivoInconsistencia?.Contains("Municipio", StringComparison.OrdinalIgnoreCase) == true)
                                    {
                                        <span class="text-warning fw-medium">📍 @r.MotivoInconsistencia</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">@r.MotivoInconsistencia</span>
                                    }
                                </td>
                                <td class="small text-truncate" style="max-width: 140px;">
                                    @(string.IsNullOrWhiteSpace(r.Fuente) ? "—" : r.Fuente)
                                </td>
                                <td class="text-center">
                                    @if (r.MotivoInconsistencia?.Contains("imagen", StringComparison.OrdinalIgnoreCase) == true)
                                    {
                                        <span class="badge badge-soft-danger">Omitido (Scan)</span>
                                    }
                                    else if (r.MotivoInconsistencia?.Contains("Corregido", StringComparison.OrdinalIgnoreCase) == true || r.MotivoInconsistencia?.Contains("Normalizado", StringComparison.OrdinalIgnoreCase) == true)
                                    {
                                        <span class="badge badge-soft-success">Corregido Auto</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-warning">Auditado</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No se encontraron inconsistencias con los criterios seleccionados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <div class="card-footer py-2 px-3 border-top d-flex justify-content-between align-items-center" style="background-color: #f1f5f9; border-color: #cbd5e1 !important;">
                <span class="small text-secondary">Mostrando @Model.RegistrosPaginados.Count registros de @Model.TotalRegistrosFiltrados</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")">
                            <a class="page-link" href="?Pagina=@(Model.Pagina - 1)&Buscar=@Model.Buscar&FiltroMotivo=@Model.FiltroMotivo">Anterior</a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">@Model.Pagina / @Model.TotalPaginas</span>
                        </li>
                        <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")">
                            <a class="page-link" href="?Pagina=@(Model.Pagina + 1)&Buscar=@Model.Buscar&FiltroMotivo=@Model.FiltroMotivo">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    // 1. Datos para Gráfica de Estado de Archivos (Doughnut)
    const datosEstadoArchivos = @Html.Raw(Model.JsonEstadoArchivos);
    const ctxArchivos = document.getElementById('chartEstadoArchivos').getContext('2d');
    new Chart(ctxArchivos, {
        type: 'doughnut',
        data: {
            labels: datosEstadoArchivos.map(d => d.Etiqueta),
            datasets: [{
                data: datosEstadoArchivos.map(d => d.Valor),
                backgroundColor: ['#1677ff', '#dc2626', '#d97706'],
                borderColor: '#ffffff',
                borderWidth: 2,
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            cutout: '68%'
        }
    });

    // 2. Datos para Gráfica de Motivos de Inconsistencia (Barras Horizontales)
    const datosMotivos = @Html.Raw(Model.JsonMotivosInconsistencias);
    const ctxMotivos = document.getElementById('chartMotivosInconsistencia').getContext('2d');
    new Chart(ctxMotivos, {
        type: 'bar',
        data: {
            labels: datosMotivos.map(d => d.Etiqueta),
            datasets: [{
                label: 'Ocurrencias',
                data: datosMotivos.map(d => d.Valor),
                backgroundColor: datosMotivos.map(d => d.Color || '#dc2626'),
                borderRadius: 4
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                x: {
                    beginAtZero: true,
                    grid: { color: '#e2e8f0' },
                    ticks: { font: { family: 'Inter', size: 10 } }
                },
                y: {
                    grid: { display: false },
                    ticks: { font: { family: 'Inter', size: 10 } }
                }
            }
        }
    });

    // 3. Gráfica de Entidades con Nombres Imprecisos / Alias
    const datosEntidades = @Html.Raw(Model.JsonInconsistenciasPorEntidad);
    const ctxEntidades = document.getElementById('chartEntidadesInconsistencias').getContext('2d');
    new Chart(ctxEntidades, {
        type: 'bar',
        data: {
            labels: datosEntidades.map(d => d.Etiqueta),
            datasets: [{
                label: 'Anomalías Detectadas',
                data: datosEntidades.map(d => d.Valor),
                backgroundColor: 'rgba(220, 38, 38, 0.75)',
                borderColor: '#dc2626',
                borderWidth: 1,
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: '#e2e8f0' },
                    ticks: { font: { family: 'Inter', size: 10 } }
                },
                x: {
                    grid: { display: false },
                    ticks: { font: { family: 'Inter', size: 10 } }
                }
            }
        }
    });

    // 4. Gráfica de Anomalías por Año (2023 - 2026)
    const datosAnios = @Html.Raw(Model.JsonInconsistenciasPorAnio);
    const ctxAnios = document.getElementById('chartAniosInconsistencias').getContext('2d');
    new Chart(ctxAnios, {
        type: 'bar',
        data: {
            labels: datosAnios.map(d => d.Etiqueta),
            datasets: [{
                label: 'Inconsistencias Registradas',
                data: datosAnios.map(d => d.Valor),
                backgroundColor: 'rgba(37, 99, 235, 0.75)',
                borderColor: '#2563eb',
                borderWidth: 1,
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: '#e2e8f0' },
                    ticks: { font: { family: 'Inter', size: 10 } }
                },
                x: {
                    grid: { display: false },
                    ticks: { font: { family: 'Inter', size: 10 } }
                }
            }
        }
    });

    // Auto-filtrado reactivo en el buscador de texto
    const inputBuscarAuditoria = document.getElementById('inputBuscarAuditoria');
    let timerBuscarAuditoria;
    if (inputBuscarAuditoria) {
        inputBuscarAuditoria.addEventListener('input', function() {
            clearTimeout(timerBuscarAuditoria);
            timerBuscarAuditoria = setTimeout(() => {
                document.getElementById('formFiltrosAuditoria').submit();
            }, 600);
        });
    }

    // Exportador a CSV
    document.getElementById('btnExportAuditoriaCsv').addEventListener('click', function() {
        const table = document.getElementById('tablaAuditoria');
        let csv = [];
        for (let row of table.rows) {
            let rowData = [];
            for (let cell of row.cells) {
                let text = cell.innerText.replace(/"/g, '""').trim();
                rowData.push('"' + text + '"');
            }
            csv.push(rowData.join(','));
        }
        const blob = new Blob(["\uFEFF" + csv.join("\n")], { type: "text/csv;charset=utf-8;" });
        const link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = "auditoria_calidad_forense_" + new Date().toISOString().slice(0, 10) + ".csv";
        link.click();
    });
</script>
}
